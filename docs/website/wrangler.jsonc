// Serves the built site, target/docs from `npm run check`, from Cloudflare at parcela.run;
// worker.mjs only handles /api/*. POSTHOG_KEY is a secret (`wrangler secret put POSTHOG_KEY`).
{
  "name": "parcela-site",
  "account_id": "d6619f1b5d5f89902029c436a998bae7",
  "compatibility_date": "2025-09-01",
  "main": "worker.mjs",
  "workers_dev": false,
  "assets": {
    "directory": "../../target/docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "parcela.run", "custom_domain": true }]
}
